    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "data = {\n",
        "    'Product': ['A', 'B', 'C', 'A', 'B', 'C', 'A', 'B', 'C', 'A', 'B', 'C'],\n",
        "    'Region':  ['North', 'North', 'North',\n",
        "                'South', 'South', 'South',\n",
        "                'East', 'East', 'East',\n",
        "                'West', 'West', 'West'],\n",
        "    'Sales':   [200, 150, 300, 220, 180, 250, 210, 170, 280, 190, 160, 310]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "print(df)\n",
        "\n",
        "total_by_product = df.groupby('Product')['Sales'].sum()\n",
        "print(total_by_product)\n",
        "\n",
        "avg_by_region = df.groupby('Region')['Sales'].mean()\n",
        "print(avg_by_region)\n",
        "\n",
        "stats_by_product = df.groupby('Product')['Sales'].agg(['mean', 'max'])\n",
        "print(stats_by_product)"
      ],
